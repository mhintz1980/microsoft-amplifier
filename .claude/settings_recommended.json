{
  "permissions": {
    "allow": [
      "Bash",
      "mcp__browser-use",
      "mcp__deepwiki",
      "WebFetch",
      "TodoWrite"
    ],
    "deny": [],
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      ".data",
      ".vscode",
      ".claude",
      ".ai",
      "~/amplifier"
    ]
  },
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": ["browser-use", "deepwiki"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/markimus/projects/microsoft-amplifier/.claude/hooks/session_start.sh",
            "timeout": 10000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/markimus/projects/microsoft-amplifier/.claude/hooks/session_end.sh",
            "timeout": 30000
          },
          {
            "type": "command",
            "command": "/home/markimus/projects/microsoft-amplifier/.claude/tools/python_hook_wrapper.sh hook_stop.py",
            "timeout": 30000
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/markimus/projects/microsoft-amplifier/.claude/tools/python_hook_wrapper.sh hook_stop.py",
            "timeout": 30000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "/home/markimus/projects/microsoft-amplifier/.claude/tools/python_hook_wrapper.sh subagent-logger.py",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/home/markimus/projects/microsoft-amplifier/.claude/tools/on_code_change_hook.sh",
            "timeout": 60000
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/home/markimus/projects/microsoft-amplifier/.claude/tools/python_hook_wrapper.sh hook_post_tool_use.py",
            "timeout": 10000
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/markimus/projects/microsoft-amplifier/.claude/tools/python_hook_wrapper.sh on_notification_hook.py",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/home/markimus/projects/microsoft-amplifier/.claude/tools/python_hook_wrapper.sh hook_precompact.py",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}